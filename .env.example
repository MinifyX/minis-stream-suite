# Nur beim Entwickeln (npm start): Die Suite liest diese Datei als .env ein.
# Die installierte App liest keine .env – dort stellt man alles in der Oberfläche ein.
# .env steht in .gitignore. Niemals echte Werte in .env.example eintragen.

# Schlüssel für die Fernsteuerung (Streamdeck, Header X-Suite-Token).
# Leer = der Schlüssel, den die Suite beim ersten Start erzeugt (Musik-/Intro-Seite → Streamdeck).
SUITE_API_TOKEN=

# Client-ID deiner Spotify-App (developer.spotify.com/dashboard), wenn in der Oberfläche keine eingetragen ist.
SPOTIFY_CLIENT_ID=

# Passwort des OBS-WebSocket-Servers, wenn in der OBS-Steuerung keins eingetragen ist.
OBS_PASSWORD=

# Zweite Instanz neben der echten Suite (eigener Datenordner und Port)
# SUITE_DATA_DIR=C:\temp\suite-test
# SUITE_PORT=7480
