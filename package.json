{
  "name": "minis-stream-suite",
  "productName": "Mini's Stream Suite",
  "version": "0.4.1",
  "description": "Stream-Toolkit für Twitch mit Addons für Alerts, Kanalpunkte, Commands, Umfragen und mehr.",
  "main": "dist/main.js",
  "private": true,
  "author": "MinifyX",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "tsc && electron .",
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "build:extension": "node browser-extension/build.mjs",
    "dist": "tsc && electron-builder --win",
    "pack": "tsc && electron-builder --win --dir",
    "plugin:install": "tsc && node scripts/install-plugin.mjs"
  },
  "build": {
    "appId": "io.github.minifyx.streamsuite",
    "productName": "Mini's Stream Suite",
    "artifactName": "Minis-Stream-Suite-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "public/**/*",
      "package.json",
      "!dist/addons/private/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mini's Stream Suite",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MinifyX",
        "repo": "minis-stream-suite"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "homepage": "https://github.com/MinifyX/minis-stream-suite",
  "repository": {
    "type": "git",
    "url": "https://github.com/MinifyX/minis-stream-suite.git"
  }
}
